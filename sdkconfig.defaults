# MLX_Player_ClassicBT - minimal native A2DP sink (PCM5102A)
# BT/I2S config replicates the battle-tested cfint514 player
# (PSRAM route, BT buffers from PSRAM first).

# ---- Bluetooth ----
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_1=y
CONFIG_BT_BLUEDROID_PINNED_TO_CORE=1
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_HFP_ENABLE=n
CONFIG_BT_SSP_ENABLED=y
CONFIG_BT_ACL_CONNECTIONS=4
CONFIG_BT_MULTI_CONNECTION_ENBALE=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BTC_TASK_STACK_SIZE=16384
CONFIG_BT_BTU_TASK_STACK_SIZE=8192
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_DAC_DMA_AUTO_16BIT_ALIGN=n

# ---- All in-stack A2DP codec decoders ----
CONFIG_BT_A2DP_SBC_DECODER=y
CONFIG_BT_A2DP_APTX_DECODER=y
CONFIG_BT_A2DP_LDAC_DECODER=y
CONFIG_BT_A2DP_OPUS_DECODER=y
CONFIG_BT_A2DP_LC3PLUS_DECODER=y
CONFIG_BT_A2DP_AAC_DECODER=y
CONFIG_BT_A2DP_LHDCV5_DECODER=y

# ---- PSRAM route (cfint514-proven; BT buffers from PSRAM first) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# ---- Performance ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_FREERTOS_HZ=1000

# ---- Flash/partition: 4MB single-app ----
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_no_ota_4MB.csv"

# ---- Console 115200 (cfint514 default) ----

# ---- Brownout OFF: USB-powered core board dips at BT TX calibration ----
# CONFIG_ESP_BROWNOUT_DET is not set

# ---- App ----
CONFIG_EXAMPLE_A2DP_SINK_AUTO_RECONNECT=y
CONFIG_LOCAL_DEVICE_NAME="A2DP_Sink_Player"
CONFIG_I2S_BCK_PIN=2
CONFIG_I2S_LRCK_PIN=15
CONFIG_I2S_DATA_PIN=14
# CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED is not set

# CONFIG_SPIRAM_CACHE_WORKAROUND is not set
