// 自定义FileStream，适配ESP-IDF的FILE*
class ESPFileStream : public Stream {
private:
    FILE* file;
public:
    ESPFileStream(FILE* f = nullptr) : file(f) {}
    
    void setFile(FILE* f) {
        file = f;
    }
    
    // 重写available()方法，避免频繁调用fseek影响性能
    int available() override {
        if (!file) return 0;
        static fpos_t current_pos, end_pos;
        static unsigned long last_check = 0;
        unsigned long now = millis();
        
        // 调整检查间隔为100ms
        if (now - last_check > 100 || end_pos == 0) {
            if (fgetpos(file, &current_pos) != 0) return 0;
            if (fseek(file, 0, SEEK_END) != 0) return 0;
            if (fgetpos(file, &end_pos) != 0) return 0;
            if (fsetpos(file, &current_pos) != 0) return 0;
            last_check = now;
        }
        return end_pos - current_pos;
    }
    
    // 重写无参数read()
    int read() override {
        if (!file) return -1;
        return fgetc(file);
    }

    // 实现readBytes而非read的重载，与Stream类规范一致，这很重要，必须要这样写，因为StreamCopy用的是readBytes！！
    size_t readBytes(uint8_t* buffer, size_t size) override {
        if (!file) return 0;
        return fread(buffer, 1, size, file);
    }
    
    // peek()实现，确保解码器能正确预读数据
    int peek() override {
        if (!file) return -1;
        int c = fgetc(file);
        if (c != EOF) ungetc(c, file);
        return c;
    }
    
    void flush() override {
        if (file) fflush(file);
    }
    
    size_t write(uint8_t) override {
        return 0; // 只读流
    }
    
    bool seek(size_t pos) {
        if (!file) return false;
        return fseek(file, pos, SEEK_SET) == 0;
    }
    
    size_t position() {
        if (!file) return 0;
        return ftell(file);
    }
    
    size_t size() {
        if (!file) return 0;
        fpos_t current, end;
        fgetpos(file, &current);
        fseek(file, 0, SEEK_END);
        fgetpos(file, &end);
        fsetpos(file, &current);
        return end;
    }
};

