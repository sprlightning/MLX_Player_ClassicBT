// 定义回调类
class AudioInfoCallback : public audio_tools::AudioInfoSupport {
private:
    audio_tools::AudioInfo current_info;
    bool is_first_update = true; // 音频信息更新标志位
public:
    void onAudioInfoChange(const audio_tools::AudioInfo& info) {  // 这里不支持override
        ESP_LOGI(TAG, "音频参数变化 - 采样率: %d, 位深: %d, 声道数: %d, 比特率: %d, 样本总数: %d",
             info.sample_rate, info.bits_per_sample, info.channels, info.bit_rate, info.total_samples);

        if (info.total_samples > 0) {
            uint32_t sd_total_duration = info.total_samples / (info.sample_rate / 1000) * 8;
            ESP_LOGI(TAG, "音频总时长: %ds", sd_total_duration);
        }
        
        // 把第一次更新且比特率为非正数视为无效音频信息
        if (is_first_update && info.bit_rate <= 0) {
            is_first_update = false;
            ESP_LOGW(TAG, "无效音频信息，已丢弃");
            return;
        }

        if (info.bit_rate <= 0) {
            ESP_LOGW(TAG, "无效音频信息，已丢弃");
            return;
        }

        // 当检测到音频参数变化时重新配置I2S并更新dac
        if (info.sample_rate != current_sample_rate || 
            info.bits_per_sample != current_bit_depth || 
            info.channels != current_channels) {
                // 只有检测到i2s自身差异时才重置i2s和更新dac
                i2s_init(I2S_PORT_NUM, info.sample_rate, info.bits_per_sample, info.channels, current_dac_mode);
                cs43131_dual_update_sample_param(info.sample_rate, info.bits_per_sample, current_dac_mode, current_codec_name);
                ESP_LOGI(TAG, "SD播放参数更新: %ldHz, %dbit, %d声道, %dkbps", 
                        info.sample_rate, info.bits_per_sample, info.channels, info.bit_rate/1000);
        } else if (info.bit_rate != audio_file_bit_rate) {
            ESP_LOGI(TAG, "SD播放参数更新: %ldHz, %dbit, %d声道, %dkbps", 
                    info.sample_rate, info.bits_per_sample, info.channels, info.bit_rate/1000);
        } else if (current_dac_mode != MODE_SLAVE) {
            ESP_LOGW(TAG, "DAC模式错误，强制设置为从模式");
            current_dac_mode = MODE_SLAVE;
        }

        // 始终用获取的音频参数更新全局i2s参数
        current_sample_rate = info.sample_rate;
        current_bit_depth = info.bits_per_sample;
        current_channels = info.channels;
        current_dac_mode = MODE_SLAVE; // 确保dac是从模式，意味着esp32的i2s是主模式
        audio_file_bit_rate = info.bit_rate; // 更新解析出的音频文件比特率到全局变量
        

        // 如果正在播放，根据新的比特率重新计算总时长
        if (sd_playing || sd_paused) {
            std::string filename = sd_music_files[current_sd_track];
            FILE* file = fopen(filename.c_str(), "rb");
            if (file) {
                fseek(file, 0, SEEK_END);
                size_t file_size = ftell(file);
                fclose(file);
                sd_total_duration = (file_size * 8) / audio_file_bit_rate;
                ESP_LOGI(TAG, "根据新比特率更新总时长: %d秒", sd_total_duration);
            }
        }

        current_info = info;
        is_first_update = false;
    }

    // 实现纯虚函数
    void setAudioInfo(audio_tools::AudioInfo info) override {
        current_info = info;
        onAudioInfoChange(info);
    }

    audio_tools::AudioInfo audioInfo() override {
        return current_info;
    }

    // 添加重置方法
    void reset() {
        current_info.clear();
        is_first_update = true;
        audio_file_bit_rate = 0;
    }
};

// 全局音频对象
I2SStream i2s_out; // final output of decoded stream
BluetoothA2DPSinkQueued a2dp_sink(i2s_out);
MultiDecoder multi; // 传统混合解码，依赖EncodedAudioStream对象来输出
MP3DecoderHelix mp3; // Codec of mp3
AACDecoderHelix aac; // Codec of aac
WAVDecoder wav;      // Codec of wav
FLACDecoderFoxen flac(5*1024, 2); // Codec of flac
EncodedAudioStream decoder(&i2s_out, &multi); // 混合解码器对象（Decoding stream）- 功能正常（需在解码器启动前注册各种解码器的mime type，否则会报错“audio-tools: The decoder could not be found for audio/mpeg”）
// StreamCopy audio_copier;  // copy in to out（不在这里初始化，稍后在audio_play_task中配置，因为它需要传入文件/数据流）
AudioInfoCallback info_callback;

// 编码器实例化
ESP32Encoder encoder;

// 范围约束函数
uint8_t constrain(uint8_t x, uint8_t min_val, uint8_t max_val) {
    if (x < min_val) return min_val;
    if (x > max_val) return max_val;
    return x;
}

// 文件类型检测
uint8_t f_typetell(const char *fname) {
    if (!fname) return 0;
    
    const char *ext = strrchr(fname, '.');
    if (!ext) return 0;
    ext++;
    
    if (strcasecmp(ext, "MP3") == 0 || strcasecmp(ext, "mp3") == 0) return FILE_MP3;
    if (strcasecmp(ext, "AAC") == 0 || strcasecmp(ext, "aac") == 0) return FILE_AAC;
    if (strcasecmp(ext, "FLAC") == 0 || strcasecmp(ext, "flac") == 0 || strcasecmp(ext, "fla") == 0) return FILE_FLAC;
    if (strcasecmp(ext, "WAV") == 0 || strcasecmp(ext, "wav") == 0) return FILE_WAV;
    if (strcasecmp(ext, "M4A") == 0 || strcasecmp(ext, "m4a") == 0) return FILE_M4A;
    
    return 0;
}

// 修正I2S DMA发送完成回调
static bool IRAM_ATTR mp3_i2s_dma_tx_callback(i2s_chan_handle_t tx_chan, i2s_event_data_t *event_data, void *arg) {
    xSemaphoreGiveFromISR(semaphore_handle, NULL);
    return false;
}

// 填充PCM数据到I2S缓冲区的函数
void mp3_fill_buffer(const uint16_t *buf, uint16_t size, uint8_t nch) {
    if (semaphore_handle == NULL) return;
    
    // 缩短超时时间并增加重试机制
    for (int retry = 0; retry < 3; retry++) {
        if (xSemaphoreTake(semaphore_handle, pdMS_TO_TICKS(20)) == pdTRUE) {
            // 在这里写入
            // 处理立体声和单声道
            size_t bytes_written = 0;
            if (nch == 2) {
                bytes_written = i2s_out.write((const uint8_t*)buf, size * 2);
            } else {  // 单声道转立体声
                uint16_t* stereo_buf = (uint16_t*)malloc(size * 2 * sizeof(uint16_t));
                for (int i = 0; i < size; i++) {
                    stereo_buf[2 * i] = buf[i];
                    stereo_buf[2 * i + 1] = buf[i];
                }
                bytes_written = i2s_out.write((const uint8_t*)stereo_buf, size * 4);
                free(stereo_buf);
            }
            
            if (bytes_written == 0) {
                ESP_LOGE(TAG, "I2S写入失败");
            }
            
            // 切换缓冲区
            mp3_which_buf = 1 - mp3_which_buf;
            return;
        }
        ESP_LOGE(TAG, "信号量获取重试: %d", retry);
    }
    
    ESP_LOGE(TAG, "信号量获取失败，放弃本次写入");
}

// SD卡音频播放任务
static void audio_play_task(void *arg) {
    esp_task_wdt_add(NULL);  // 添加看门狗
    const char* file_path = (const char*)arg;
    uint8_t file_type = f_typetell(file_path);

    // 再次校验文件类型（防止切换过程中发生变化）
    if (file_type != FILE_MP3 && file_type != FILE_AAC && 
        file_type != FILE_WAV && file_type != FILE_FLAC) {
        ESP_LOGE(TAG, "文件类型与解码器不匹配，跳过播放");
        sd_playing = false;
        vTaskDelete(NULL);
        sd_next_track(); // 自动播放下一曲
        return;
    }

    // 文件打开操作
    FILE* file = fopen(file_path, "rb");
    if (!file) {
        ESP_LOGE(TAG, "无法打开文件: %s", file_path);
        sd_playing = false;
        audio_play_task_handle = NULL;
        esp_task_wdt_delete(NULL);
        vTaskDelete(NULL);
        return;
    }
    g_current_file = file; // 保存全局文件指针

    ESPFileStream file_stream(file);
    // 如果有保存的播放位置，跳转到该位置
    if (sd_current_file_pos > 0) {
        if (!file_stream.seek(sd_current_file_pos)) {
            ESP_LOGE(TAG, "无法定位到暂停位置");
            sd_current_file_pos = 0;
        } else {
            ESP_LOGI(TAG, "从位置 %d 继续播放", sd_current_file_pos);
        }
    }

    // 检查文件是否可读取
    if (file_stream.available() <= 0) {
        ESP_LOGE(TAG, "文件为空或无法读取: %s", file_path);
        fclose(file);
        sd_playing = false;
        vTaskDelete(NULL);
        return;
    }

    // 依据音频文件更新编码类型
    switch (f_typetell(file_path)) {
        case FILE_MP3: current_codec_name = "MP3"; break;
        case FILE_AAC: current_codec_name = "AAC"; break;
        case FILE_WAV: current_codec_name = "WAV"; break;
        case FILE_FLAC: current_codec_name = "FLAC"; break;
        case FILE_M4A: current_codec_name = "M4A"; break;
        default:
            ESP_LOGE(TAG, "不支持的文件类型: %s", file_path);
            fclose(file);
            sd_playing = false;
            vTaskDelete(NULL);
            return;
    }

    // 流复制器，参数依次是解码器、文件流、缓冲区大小
    StreamCopy copier(decoder, file_stream, 4096);  // 流复制器（copy in to out），推荐4096
    size_t file_size = file_stream.size();
    uint32_t last_progress_update = 0;
    int consecutive_errors = 0; // 连续错误计数器

    ESP_LOGI(TAG, "开始播放文件: %s, 类型: %s", file_path, current_codec_name);

    ESP_LOGI(TAG, "sd_playing: %s | sd_paused: %s | sd_manual_sw: %s", 
        sd_playing ? "true" : "false", sd_paused ? "true" : "false", sd_manual_sw ? "true" : "false");

    if (current_codec_name == (const char *)"WAV" || 
        current_codec_name == (const char *)"FLAC") {
        // 手动触发I2S初始化（避免无声音/变调）
        audio_tools::AudioInfo default_info;
        default_info.sample_rate = 44100;
        default_info.bits_per_sample = 16;
        default_info.channels = 2;
        default_info.bit_rate = default_info.sample_rate * default_info.bits_per_sample * default_info.channels;
        audio_file_bit_rate = default_info.bit_rate;
        info_callback.setAudioInfo(default_info); // 强制触发配置
    } else {
        info_callback.reset(); // 解析前先清除音频信息
        // 等待比特率解析
        uint32_t wait_start = millis();
        const uint32_t MAX_WAIT_MS = 3000;
        while (audio_file_bit_rate == 0 && sd_playing) { // 只要比特率为0且在播放就解析
            esp_task_wdt_reset();  // 等待时喂狗
            // ESP_LOGI(TAG, "等待解析比特率...");
            uint8_t buffer[1024];
            size_t read = file_stream.readBytes(buffer, sizeof(buffer));
            if (read > 0) decoder.write(buffer, read); // 强制解码器处理任务
            // if (millis() - wait_start > MAX_WAIT_MS) {
            //     ESP_LOGW(TAG, "比特率解析超时，使用默认值320000bps继续播放");
            //     audio_file_bit_rate = 320000;  // 默认比特率
            //     break;
            // }
            if (millis() - wait_start > MAX_WAIT_MS) { // 备用逻辑
                ESP_LOGW(TAG, "比特率解析超时，尝试默认配置启动I2S");
                // 手动触发I2S初始化（避免无声音/变调）
                audio_tools::AudioInfo default_info;
                default_info.sample_rate = 44100;
                default_info.bits_per_sample = 16;
                default_info.channels = 2;
                if (current_codec_name == (const char *)"FLAC") default_info.bit_rate = 1000000; else default_info.bit_rate = 320000;
                audio_file_bit_rate = default_info.bit_rate;
                info_callback.setAudioInfo(default_info); // 强制触发配置
                break;
            }
            vTaskDelay(pdMS_TO_TICKS(100));
        }
    }

    // 计算总时长（秒）：文件大小（字节）*8 / 比特率（bps）
    if (audio_file_bit_rate <= 0) {
        audio_file_bit_rate = 320000;
        ESP_LOGE(TAG, "检测到非正数值，推测是未触发比特率解析，暂用320000bps代替，需要检查错误！");
    }
    sd_total_duration = (file_size * 8) / audio_file_bit_rate;
    ESP_LOGI(TAG, "解析到%s比特率: %dkbps, 总时长: %d秒", current_codec_name, audio_file_bit_rate/1000, sd_total_duration);

    // 核心播放循环：支持暂停/恢复
    while (sd_playing || sd_paused) {  // 不管sd_playing是否为true都进入循环
        esp_task_wdt_reset();  // 持续喂狗

        // 每50ms额外喂一次狗，防止长时间操作导致超时 - 测试内容
        static uint32_t last_wdt_reset = 0;
        if (millis() - last_wdt_reset > 50) {
            esp_task_wdt_reset();
            last_wdt_reset = millis();
        }

        // 状态有效性检查
        if (!file || file_stream.available() < 0) {
            ESP_LOGE(TAG, "文件流异常，终止播放");
            sd_playing = false;
            sd_paused = false;
            break;
        }

        // 暂停处理：循环等待，不退出任务
        while (sd_paused) { // 因为暂停导致sd_playing为false，就留在这里喂狗
            esp_task_wdt_reset();  // 暂停时也要喂狗
            if (!sd_paused) break; // 检查是否已恢复播放
            vTaskDelay(pdMS_TO_TICKS(10));  // 缩短延迟至10ms，提高响应速度
        }

        // 检查是否需要退出
        if (!sd_playing || sd_manual_sw) {
            ESP_LOGI(TAG, "检测到非播放或手动切换标志，退出解码循环");
            break;
        }

        // 正常播放：复制音频数据
        if (file_stream.available() > 0) {
            size_t copied = copier.copy();
            if (copied == 0) {
                consecutive_errors++;
                if (consecutive_errors > 5) {
                    ESP_LOGW(TAG, "流复制失败，错误计数: %d", consecutive_errors);
                    consecutive_errors = 0;
                }
                vTaskDelay(pdMS_TO_TICKS(10));
            } else {
                consecutive_errors = 0; // 重置错误计数器
            }
        } else {
            // 文件播放完毕，自动切换下一曲
            break;
        }

        // 每1000ms更新一次播放进度（仅debug用，解码循环最好不要干无关的事）
        if (millis() - last_progress_update > 1000) {
            sd_current_position = file_stream.position();
            uint32_t current_seconds = 0;
            // 使用实际比特率计算当前播放时间 - 支持动态更新的比特率
            if (audio_file_bit_rate > 0) {
                current_seconds = (sd_current_position * 8) / audio_file_bit_rate;
            } else {
                // 没有有效比特率时使用常用比特率估算
                if (current_codec_name == (const char *)"FLAC") {
                    current_seconds = (sd_current_position * 8) / 1000000; // FLAC，粗略用1000000bps来估算
                } else {
                    current_seconds = (sd_current_position * 8) / 320000; // 其它如mp3等，粗略用320000bps来估算
                }
            }
            
            // 实测效果还行
            ESP_LOGI(TAG, "播放进度: %d:%02d/%d:%02d (%d%%)",
                        current_seconds / 60, current_seconds % 60,
                        sd_total_duration / 60, sd_total_duration % 60,
                        (int)((float)sd_current_position / file_size * 100));

            last_progress_update = millis();
        }
    }

    // 保存当前位置用于暂停功能
    if (sd_paused) {
        sd_current_file_pos = file_stream.position();
        ESP_LOGI(TAG, "已暂停，当前位置: %d", sd_current_file_pos);
    } else {
        sd_current_file_pos = 0;
    }

    // 清理资源 - 必须要在切换下一首前清理资源
    // 否则会报错“audio-tools: write  to target has failed after 22 retries! (1024 bytes)”
    fclose(file);
    g_current_file = NULL;
    decoder.end();  // 停止解码

    // 任务退出处理
    if (!sd_paused && !sd_manual_sw) {  // 若不是暂停/手动切换，说明播放完成或手动切换
        sd_playing = false;
        if (!sd_music_files.empty() && !sd_manual_sw) {
            vTaskDelay(pdMS_TO_TICKS(100));
            ESP_LOGI(TAG, "播放完成，自动播放下一曲");
            sd_next_track();  // 自动播放下一曲 - 在这之前一起要清理掉播放上一首的资源
        }
    }

    // 重置任务句柄
    audio_play_task_handle = NULL;
    esp_task_wdt_delete(NULL);  // 退出前删除看门狗
    vTaskDelete(NULL);  // 任务自我终止
}

// SPI初始化
static esp_err_t spi_init(void) {
    spi_bus_config_t bus_config = {
        .mosi_io_num = SPI_MOSI,
        .miso_io_num = SPI_MISO,
        .sclk_io_num = SPI_CLK,
        .quadwp_io_num = -1,
        .quadhd_io_num = -1,
        .max_transfer_sz = 0,
    };
    
    esp_err_t ret = spi_bus_initialize(SPI3_HOST, &bus_config, SPI_DMA_CH_AUTO);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "SPI初始化失败: %s", esp_err_to_name(ret));
        return ret;
    }
    
    gpio_reset_pin(SPI_CS);
    gpio_set_direction(SPI_CS, GPIO_MODE_OUTPUT);
    gpio_set_level(SPI_CS, 1);
    
    ESP_LOGI(TAG, "SPI初始化完成");
    return ret;
}

// 编码器和按键初始化
static esp_err_t buttons_init(void) {
    encoder.attachHalfQuad(ENCODER_A, ENCODER_B);
    encoder.setFilter(10);
    encoder.setCount(0);
    encoder_position = 0;
    last_encoder_position = 0;
    
    gpio_reset_pin(ENCODER_BUTTON);
    gpio_set_direction(ENCODER_BUTTON, GPIO_MODE_INPUT);
    gpio_set_pull_mode(ENCODER_BUTTON, GPIO_PULLUP_ONLY);
    
    gpio_reset_pin(BUTTON1);
    gpio_set_direction(BUTTON1, GPIO_MODE_INPUT);
    gpio_set_pull_mode(BUTTON1, GPIO_PULLUP_ONLY);
    
    gpio_reset_pin(BUTTON2);
    gpio_set_direction(BUTTON2, GPIO_MODE_INPUT);
    gpio_set_pull_mode(BUTTON2, GPIO_PULLUP_ONLY);
    
    gpio_reset_pin(SD_DET);
    gpio_set_direction(SD_DET, GPIO_MODE_INPUT);
    gpio_set_pull_mode(SD_DET, GPIO_PULLUP_ONLY);
    
    ESP_LOGI(TAG, "按键和编码器初始化完成");
    return ESP_OK;
}

// I2C初始化
static esp_err_t i2c_init(i2c_port_t port, uint32_t freq, uint8_t i2c_sda, uint8_t i2c_scl) {
    i2c_config_t i2c_cfg = {
        .mode = I2C_MODE_MASTER,
        .sda_io_num = i2c_sda,
        .scl_io_num = i2c_scl,
        .sda_pullup_en = GPIO_PULLUP_ENABLE,
        .scl_pullup_en = GPIO_PULLUP_ENABLE,
        .master = {
            .clk_speed = freq,
        },
    };
    
    esp_err_t ret = i2c_param_config(port, &i2c_cfg);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "I2C参数配置失败: %s", esp_err_to_name(ret));
        return ret;
    }
    
    ret = i2c_driver_install(port, i2c_cfg.mode, 0, 0, 0);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "I2C驱动安装失败: %s", esp_err_to_name(ret));
        return ret;
    }
    
    ESP_LOGI(TAG, "I2C初始化完成, port: %d, freq: %dHz", port, freq);
    return ret;
}

// 修正I2S初始化函数
static esp_err_t i2s_init(uint8_t port, uint32_t sample_rate, uint32_t _bits_per_sample, 
                         uint32_t _channels, cs43131_mode_t dac_mode) {
    if (sample_rate <= 0 || _bits_per_sample <= 0) return ESP_FAIL;

    const char *esp_i2s_mode = (dac_mode == MODE_MASTER) ? "Slave" : "Master";

    ESP_LOGI(TAG, "准备初始化I2S");

    // 确保I2S资源已释放
    if (i2s_out.isActive()) {
        i2s_out.end();
        vTaskDelay(pdMS_TO_TICKS(100));
        // 额外的硬件重置
        gpio_set_level(I2S_BCK, 0);
        gpio_set_level(I2S_WS, 0);
        gpio_set_level(I2S_DO, 0);
        vTaskDelay(pdMS_TO_TICKS(50));
    }

    // 硬件重置
    gpio_reset_pin(I2S_BCK);
    gpio_reset_pin(I2S_WS);
    gpio_reset_pin(I2S_DO);
    vTaskDelay(pdMS_TO_TICKS(10));

    I2SConfig i2s_cfg;
    i2s_cfg.channels = _channels;
    i2s_cfg.sample_rate = sample_rate;
    i2s_cfg.bits_per_sample = _bits_per_sample;
    i2s_cfg.rx_tx_mode = TX_MODE;
    i2s_cfg.i2s_format = I2S_PHILIPS_FORMAT;
    i2s_cfg.signal_type = Digital;
    i2s_cfg.is_master = (esp_i2s_mode == (char *)"Master") ? true : false; 
    i2s_cfg.port_no = I2S_PORT_NUM;
    i2s_cfg.pin_ws = I2S_WS;
    i2s_cfg.pin_bck = I2S_BCK;
    i2s_cfg.pin_data = I2S_DO;
    i2s_cfg.pin_data_rx = -1;
    i2s_cfg.pin_mck = (esp_i2s_mode == (char *)"Master") ? I2S_MCK : -1;
    i2s_cfg.buffer_count = 3; // 推荐3
    i2s_cfg.buffer_size = 1024; // 推荐1024
    i2s_cfg.use_apll = (esp_i2s_mode == (char *)"Master") ? true : false;
    i2s_cfg.auto_clear = true;
    i2s_cfg.channel_format = I2SChannelSelect::Default;
    i2s_cfg.mclk_multiple = -1;

    if (!i2s_out.begin(i2s_cfg)) {
        ESP_LOGE(TAG, "I2S初始化失败");
        return ESP_FAIL;
    }

    size_t dma_total_size = i2s_cfg.buffer_count * i2s_cfg.buffer_size;
    int frame_size = i2s_cfg.bits_per_sample * i2s_cfg.channels / 8;
    size_t total_frames = dma_total_size / frame_size;
    float buffer_duration = (float)total_frames / i2s_cfg.sample_rate;

    ESP_LOGI(TAG, "I2S init success, port%d | %ldHz | %dbit | %dchs | %s | DMA: %dbytes | %.2fms", 
        port, sample_rate, _bits_per_sample, _channels, esp_i2s_mode, dma_total_size, buffer_duration * 1000);
    return ESP_OK;
}

// 音频状态回调函数
void audio_state_changed(esp_a2d_audio_state_t state, void *user_data) {
    static esp_a2d_audio_state_t last_state = ESP_A2D_AUDIO_STATE_STOPPED;
    current_audio_state = state;

    if (last_state != state) {
        if (state == ESP_A2D_AUDIO_STATE_STARTED) {
            ESP_LOGI(TAG, "切歌成功，正在播放");
        }
        last_state = state;
    }

    switch (state) {
        case ESP_A2D_AUDIO_STATE_REMOTE_SUSPEND: 
            ESP_LOGI(TAG, "音频已暂停"); 
            break;
        case ESP_A2D_AUDIO_STATE_STOPPED: 
            ESP_LOGI(TAG, "音频已停止"); 
            break;
        case ESP_A2D_AUDIO_STATE_STARTED: 
            ESP_LOGI(TAG, "音频已开始"); 
            break;
        default: 
            ESP_LOGI(TAG, "音频状态: %d", state); 
            break;
    }
}

// 连接状态回调函数
void connection_state_changed(esp_a2d_connection_state_t state, void *user_data) {
    bool connected = (state == ESP_A2D_CONNECTION_STATE_CONNECTED);
    switch (state) {
        case ESP_A2D_CONNECTION_STATE_DISCONNECTED: 
            ESP_LOGI(TAG, "bt连接状态: 已断开"); 
            if (current_state == STATE_BLUETOOTH_PLAY) {
                OLED_Clear();
                OLED_ShowCJKString(0, 2, "请连接蓝牙:", 12, true);
                OLED_ShowString(24, 4, bt_name, 12, true);
            }
            break;
        case ESP_A2D_CONNECTION_STATE_CONNECTING: 
            ESP_LOGI(TAG, "bt连接状态: 正在连接"); 
            if (current_state == STATE_BLUETOOTH_PLAY) {
                OLED_Clear();
                OLED_ShowCJKString(0, 2, "A2DP协商中", 12, true);
                OLED_ShowCJKString(24, 4, "请等待...", 12, true);
            }
            break;
        case ESP_A2D_CONNECTION_STATE_CONNECTED: 
            ESP_LOGI(TAG, "bt连接状态: 已连接"); 
            if (a2dp_sink.is_avrc_connected()) {
                ESP_LOGI(TAG, "AVRC连接成功，支持音量同步");
            } else {
                ESP_LOGW(TAG, "AVRC连接失败，音量同步不可用");
            }
            break;
        case ESP_A2D_CONNECTION_STATE_DISCONNECTING: 
            ESP_LOGI(TAG, "bt连接状态: 正在断开"); 
            break;
        default: 
            ESP_LOGI(TAG, "bt连接状态: 未知状态"); 
            break;
    }
}

// 判断两首歌的元数据是否相同
bool is_metadata_equal(const SongMetadata* a, const SongMetadata* b) {
    return (strcmp(a->album, b->album) == 0);
}

// 元数据回调函数
void avrc_metadata_callback(uint8_t attribute_id, const uint8_t *metadata) {
    if (metadata == NULL) return;

    switch (attribute_id) {
        case ESP_AVRC_MD_ATTR_TITLE:
            // 注意这里才是元数据更新后实时更新的地方
            if (is_new_song) {
                // 首次传输：作为歌曲标题存入track_title
                strncpy(current_metadata.track_title, (char*)metadata, sizeof(current_metadata.track_title)-1);
                current_metadata.track_title[sizeof(current_metadata.track_title)-1] = '\0';
                ESP_LOGI(TAG, "歌曲标题: %s", current_metadata.track_title);
                // 这里显示歌曲标题（占用第2-3页）
                if (strlen(current_metadata.track_title) > 0) {
                    OLED_ClearPage(2, 4); // 要多清除一页
                    OLED_ShowCJKString(12, 2, current_metadata.track_title, 12, true);
                } else {
                    OLED_ShowCJKString(12, 2, "未知曲目", 12, true);
                }
            } else {
                // 后续传输：作为歌词存入title
                strncpy(current_metadata.title, (char*)metadata, sizeof(current_metadata.title)-1);
                current_metadata.title[sizeof(current_metadata.title)-1] = '\0';
                ESP_LOGI(TAG, "歌词: %s", current_metadata.title);
                // 歌词显示在OLED第4页及以后
                if (strlen(current_metadata.title) > 0) {
                    OLED_ClearPage(4, 8);  // 清空歌词区域
                    OLED_ShowCJKString(0, 4, current_metadata.title, 12, true);
                }
            }
            // 更新播放/暂停符号
            if (current_state == STATE_BLUETOOTH_PLAY && current_audio_state == ESP_A2D_AUDIO_STATE_STARTED) {
                OLED_ShowCJKString(0, 2, "⏸", 12, true); // 显示播放状态
            } else if (current_state == STATE_BLUETOOTH_PLAY && 
                (current_audio_state == ESP_A2D_AUDIO_STATE_REMOTE_SUSPEND || 
                current_audio_state == ESP_A2D_AUDIO_STATE_STOPPED)){
                OLED_ShowCJKString(0, 2, "▶", 12, true); // 显示暂停状态
            }
            break;
        case ESP_AVRC_MD_ATTR_ARTIST:
            strncpy(current_metadata.artist, (char*)metadata, sizeof(current_metadata.artist)-1);
            current_metadata.artist[sizeof(current_metadata.artist)-1] = '\0';
            break;
        case ESP_AVRC_MD_ATTR_ALBUM:
            strncpy(current_metadata.album, (char*)metadata, sizeof(current_metadata.album)-1);
            current_metadata.album[sizeof(current_metadata.album)-1] = '\0';
            break;
        case ESP_AVRC_MD_ATTR_GENRE:
            strncpy(current_metadata.genre, (char*)metadata, sizeof(current_metadata.genre)-1);
            current_metadata.genre[sizeof(current_metadata.genre)-1] = '\0';
            break;
        case ESP_AVRC_MD_ATTR_TRACK_NUM:
            strncpy(current_metadata.track_num, (char*)metadata, sizeof(current_metadata.track_num)-1);
            current_metadata.track_num[sizeof(current_metadata.track_num)-1] = '\0';
            is_metadata_complete = true;
            break;
        default:
            return;
    }

    if (is_metadata_complete) {
        if (!is_metadata_equal(&current_metadata, &last_metadata)) {
            is_new_song = true; // 标记为新歌
            ESP_LOGI(TAG, "====== 发现歌曲 ======");
            ESP_LOGI(TAG, "标题: %s | 艺术家: %s | 专辑: %s | 流派: %s | 曲目号: %s", 
                current_metadata.track_title, current_metadata.artist, current_metadata.album, current_metadata.genre, current_metadata.track_num);
            ESP_LOGI(TAG, "======================");
            
            memcpy(&last_metadata, &current_metadata, sizeof(SongMetadata));
        } else {
            is_new_song = false; // 同一首歌，后续传输为歌词
        }
        is_metadata_complete = false;
    }
}

// codec配置回调函数
void codec_config_callback(uint32_t rate, uint8_t bps, uint8_t channels, const char* codec_name) {
    esp_a2d_audio_state_t prev_state = current_audio_state;
    ESP_LOGI(TAG, "切换codec前A2DP_SINK的状态: %s", (prev_state == 0) ? "暂停/停止" : "播放");

    current_sample_rate = rate;
    current_bit_depth = bps;
    current_channels = channels;
    current_codec_name = codec_name;

    ESP_LOGI(TAG, "检测到A2DP音频配置变更(%s | %ldHz | %dbit | %dchs), 准备同步到codec", 
        codec_name, rate, bps, channels);

    a2dp_sink.pause();
    vTaskDelay(pdMS_TO_TICKS(20));

    cs43131_mode_t dac_mode_temp = current_dac_mode;
    current_dac_mode = MODE_SLAVE;

    bool need_restart = (current_sample_rate != rate) || (current_dac_mode != dac_mode_temp) || (current_channels != channels);
    if (need_restart) {
        if (prev_state == ESP_A2D_AUDIO_STATE_STARTED) a2dp_sink.pause();
        vTaskDelay(pdMS_TO_TICKS(30));
        i2s_out.end();
        vTaskDelay(pdMS_TO_TICKS(30));
        i2s_init(I2S_PORT_NUM, current_sample_rate, current_bit_depth, current_channels, current_dac_mode);
    }

    if (current_sample_rate >= 88200) {
        a2dp_sink.set_i2s_ringbuffer_prefetch_percent(75);
    } else if (current_sample_rate >= 48000) {
        a2dp_sink.set_i2s_ringbuffer_prefetch_percent(65);
    } else {
        a2dp_sink.set_i2s_ringbuffer_prefetch_percent(55);
    }

    cs43131_dual_update_sample_param(rate, bps, current_dac_mode, current_codec_name);

    if (current_state == STATE_BLUETOOTH_PLAY) {
        OLED_Clear();
        OLED_ShowCJKString(0, 2, current_metadata.title, 12, true);
        OLED_ShowString(0, 4, current_metadata.artist, 12, true);
        oled_show_info(current_dac_mode, current_sample_rate, current_bit_depth, current_codec_name, get_local_vol());
    }

    if (prev_state == ESP_A2D_AUDIO_STATE_STARTED) a2dp_sink.play();
}

// I2C设备扫描函数
static esp_err_t i2c_scan(i2c_port_t port) {
    ESP_LOGI(TAG, "在port%d扫描I2C设备...", port);
    for (uint8_t addr = 0x08; addr < 0x77; addr++) {
        i2c_cmd_handle_t cmd = i2c_cmd_link_create();
        i2c_master_start(cmd);
        i2c_master_write_byte(cmd, (addr << 1) | I2C_MASTER_WRITE, true);
        i2c_master_stop(cmd);
        esp_err_t ret = i2c_master_cmd_begin(port, cmd, 100 / portTICK_PERIOD_MS);
        i2c_cmd_link_delete(cmd);
        if (ret == ESP_OK) {
            ESP_LOGI(TAG, "发现I2C设备(写地址): 0x%02X", addr << 1);
        }
    }
    return ESP_OK;
}

// oled状态栏更新
static void oled_show_info(cs43131_mode_t dac_mode, 
                           uint32_t sample_rate, uint8_t bit_depth, const char* codec_name, uint8_t vol) {
    OLED_ClearPage(0, 1);

    uint8_t num_0r = 0;
    OLED_ShowString(num_0r * 6, 0, codec_name, 8, false);
    if (codec_name == (const char *)">B<" || codec_name == (const char *)"SBC" || 
        codec_name == (const char *)"AAC" || codec_name == (const char *)"aac" || 
        codec_name == (const char *)"MP3" || codec_name == (const char *)"mp3" || 
        codec_name == (const char *)"WAV" || codec_name == (const char *)"wav" || 
        codec_name == (const char *)"M4A" || codec_name == (const char *)"m4a") num_0r += 3;
    else if (codec_name == (const char *)"aptX" || codec_name == (const char *)"LDAC" || 
        codec_name == (const char *)"FLAC" || codec_name == (const char *)"flac" ||
        codec_name == (const char *)"OPUS" || codec_name == (const char *)"opus") num_0r += 4;
    else if (codec_name == (const char *)"aptX-LL" || codec_name == (const char *)"aptX-HD" || 
             codec_name == (const char *)"LHDC V5") num_0r += 7;
    num_0r += 1;
    
    const char *dac_mode_chr = (dac_mode == MODE_MASTER) ? "M" : "S";
    OLED_ShowString(num_0r * 6, 0, "D:", 8, true); num_0r += 2;
    OLED_ShowString(num_0r * 6, 0, dac_mode_chr, 8, true);
    num_0r += 2;
    
    OLED_ShowNum(num_0r * 6, 0, (int)sample_rate / 1000, 8, true);
    if (sample_rate <= 96000) num_0r += 2; else num_0r += 3;
    OLED_ShowString(num_0r * 6, 0, "k/", 8, true); num_0r += 2;
    
    OLED_ShowNum(num_0r * 6, 0, bit_depth, 8, true); num_0r += 2;
    OLED_ShowString(num_0r * 6, 0, "b", 8, true); 
    num_0r += 2;
    
    OLED_ShowNum(num_0r * 6, 0, vol, 8, true);
    
    for (int i = 0; i < 16; i++) {
        OLED_ShowString(i * 8, 1, "-", 8, true);
    }
}

// 编码器和按键处理任务 - 确保息屏时只亮屏不执行功能操作
static void input_handler_task(void *arg) {
    esp_task_wdt_add(NULL);
    
    while (1) {
        esp_task_wdt_reset();
        
        // 读取原始输入状态
        long current_encoder_pos = encoder.getCount() / 2;
        bool encoder_changed = (current_encoder_pos != last_encoder_position);
        bool encoder_key_pressed = (gpio_get_level(ENCODER_BUTTON) == 0);
        
        // 检测到任何输入活动
        bool user_activity = encoder_changed || encoder_key_pressed;
        
        // 息屏状态处理：只亮屏，不执行任何功能
        if (user_activity && !screen_on) {
            screen_on = true;
            OLED_Display_On();
            last_user_activity = millis(); // 更新用户活动时间戳，避免立即再次息屏
            // 彻底重置输入状态，避免亮屏瞬间的输入被处理
            last_encoder_position = current_encoder_pos;
            encoder_position = current_encoder_pos;
            encoder_changed = false;
            encoder_scrolled = false;
            encoder_key_state = KEY_IDLE;
            encoder_key_press_time = 0;
            vTaskDelay(pdMS_TO_TICKS(300)); // 延迟避免抖动，至少要大于200ms，推荐用300ms以上
            // 直接跳过本次循环的功能处理
            check_screen_timeout();
            vTaskDelay(pdMS_TO_TICKS(10));
            continue;
        }
        
        // 只有亮屏状态才处理输入功能
        if (screen_on) {
            // 处理编码器滚动
            if (encoder_changed) {
                encoder_position = current_encoder_pos;
                encoder_scrolled = true;
            }
            
            // 处理按键状态
            switch (encoder_key_state) {
                case KEY_IDLE:
                    if (encoder_key_pressed) {
                        encoder_key_state = KEY_PRESSED;
                        encoder_key_press_time = millis(); // 记录编码器按下的时间
                        encoder_rotated_while_pressed = false; // 重置按压期间的转动标志
                    }
                    break;
                    
                case KEY_PRESSED:
                    // 检测到编码器转动且按键被按下
                    if (encoder_changed && encoder_key_pressed) {
                        encoder_rotated_while_pressed = true;
                    }
                    if (!encoder_key_pressed) {
                        unsigned long press_duration = millis() - encoder_key_press_time; // 计算按压时间
                        // 如果按压期间有转动，则只按短按处理
                        if (encoder_rotated_while_pressed) {
                            // encoder_key_state = KEY_SHORT_PRESS;
                            vTaskDelay(pdMS_TO_TICKS(10)); // 按压期间转动视为什么都没有做，延时避免空操作
                        } else {
                            // 如果未转动，则根据按压时间判断是短按还是长按
                            encoder_key_state = (press_duration >= LONG_PRESS_THRESHOLD) ? KEY_LONG_PRESS : KEY_SHORT_PRESS;
                        }
                    } else if (millis() - encoder_key_press_time >= LONG_PRESS_THRESHOLD && !encoder_rotated_while_pressed) {
                        // 如果达到长按阈值且编码器未转动，则按长按处理
                        encoder_key_state = KEY_LONG_PRESS;
                    }
                    break;
                    
                case KEY_SHORT_PRESS:
                case KEY_LONG_PRESS:
                case KEY_RELEASED:
                    encoder_key_state = KEY_IDLE;
                    break;
            }
            
            // 执行输入功能处理
            handle_encoder_input();
            handle_menu_navigation();
            
            // 更新用户活动时间
            if (user_activity) {
                last_user_activity = millis();
            }
        }
        
        // 检查屏幕超时
        check_screen_timeout();
        
        // 保存编码器状态
        last_encoder_position = current_encoder_pos;
        encoder_scrolled = false;
        
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}

// 重置元数据
void reset_metadata() {
    memset(&current_metadata, 0, sizeof(SongMetadata));
    is_new_song = true;
    is_metadata_complete = false;
}

// 编码器输入处理函数，添加screen_on检查
static void handle_encoder_input() {
    // 只有亮屏状态才处理输入
    if (!screen_on) return;
    
    if (!encoder_software_lock && encoder_scrolled) {
        long diff = encoder_position - last_encoder_position;
        
        switch (current_state) {
            case STATE_POWER_OFF:
                // 什么也不用做
                break;
            case STATE_WELCOME:
                // 什么也不用做
                break;
            case STATE_MAIN_MENU:
                current_menu = (MenuOption)((current_menu + diff + MENU_COUNT) % MENU_COUNT);
                draw_main_menu();
                break;
                
            case STATE_BLUETOOTH_PLAY:
                if (gpio_get_level(ENCODER_BUTTON) != 0 && diff != 0) {
                    int32_t new_vol = avrc_vol + diff * VOLUME_STEP;
                    avrc_vol = (new_vol < AVRC_VOLUME_MIN) ? AVRC_VOLUME_MIN :
                              (new_vol > AVRC_VOLUME_MAX) ? AVRC_VOLUME_MAX : new_vol;
                    
                    if (a2dp_sink.is_avrc_connected()) {
                        a2dp_sink.set_volume(avrc_vol);
                        ESP_LOGI(TAG, "本地avrc_vol: %d → 同步到A2DP Source", avrc_vol);
                    }
                    
                    oled_show_info(current_dac_mode, current_sample_rate, current_bit_depth, current_codec_name, get_local_vol());
                } else if (gpio_get_level(ENCODER_BUTTON) == 0 && diff != 0) {
                    if (a2dp_sink.is_connected() && a2dp_sink.is_avrc_connected()) {
                        static unsigned long last_switch_time = 0;
                        unsigned long current_time = millis();
                        
                        if (current_time - last_switch_time > 500) {
                            a2dp_sink.pause();
                            current_audio_state = ESP_A2D_AUDIO_STATE_REMOTE_SUSPEND;
                            vTaskDelay(pdMS_TO_TICKS(50));
                            reset_metadata();
                            if (diff > 0) {
                                a2dp_sink.next();
                                ESP_LOGI(TAG, "切换下一曲歌曲");
                            } else {
                                a2dp_sink.previous();
                                ESP_LOGI(TAG, "切换上一曲歌曲");
                            }
                            vTaskDelay(pdMS_TO_TICKS(50));
                            a2dp_sink.play();
                            current_audio_state = ESP_A2D_AUDIO_STATE_STARTED;
                            last_switch_time = current_time;
                        }

                        // 更新播放/暂停符号
                        if (current_state == STATE_BLUETOOTH_PLAY && current_audio_state == ESP_A2D_AUDIO_STATE_STARTED) {
                            OLED_ShowCJKString(0, 2, "⏸", 12, true); // 显示播放状态
                        } else if (current_state == STATE_BLUETOOTH_PLAY && 
                            (current_audio_state == ESP_A2D_AUDIO_STATE_REMOTE_SUSPEND || 
                            current_audio_state == ESP_A2D_AUDIO_STATE_STOPPED)){
                            OLED_ShowCJKString(0, 2, "▶", 12, true); // 显示暂停状态
                        }
                    }
                }
                break;
                
            case STATE_SD_PLAY:
                if (gpio_get_level(ENCODER_BUTTON) != 0) {
                    if (diff != 0) {
                        int32_t new_vol = cs43131_vol + diff * VOLUME_STEP;
                        cs43131_vol = (new_vol < DAC_VOLUME_MIN) ? DAC_VOLUME_MIN :
                                     (new_vol > DAC_VOLUME_MAX) ? DAC_VOLUME_MAX : new_vol;
                        
                        cs43131_set_vol(CS43131L_ADDR, cs43131_vol);
                        cs43131_set_vol(CS43131R_ADDR, cs43131_vol);
                        
                        draw_sd_play_screen();
                    }
                } else {
                    if (diff != 0) {
                        // 标记在按键按下期间发生了转动
                        encoder_rotated_while_pressed = true;
                        static unsigned long last_switch_time = 0;
                        unsigned long current_time = millis();
                        
                        if (current_time - last_switch_time > 500) {
                            if (diff > 0) {
                                ESP_LOGI(TAG, "手动切换到下一曲");
                                sd_manual_sw = true; // 设置手动切换标志，确保手动切换下一曲时，不会再自动切换下一曲
                                sd_next_track();
                            } else {
                                ESP_LOGI(TAG, "手动切换到上一曲");
                                sd_manual_sw = true;
                                sd_prev_track();
                            }
                            last_switch_time = current_time;
                        }
                    }
                }
                break;
                
            case STATE_SETTINGS:
                screen_timeout = (uint8_t)constrain(screen_timeout + diff, SCREEN_TIMEOUT_MIN, SCREEN_TIMEOUT_MAX);
                draw_settings_screen();
                break;
                
            case STATE_SHUTDOWN_CONFIRM:
                break;
                
            default:
                break;
        }
    }
    
    if (encoder_key_state == KEY_SHORT_PRESS) {
        switch (current_state) {
            case STATE_WELCOME:
                update_system_state(STATE_MAIN_MENU);
                break;
                
            case STATE_MAIN_MENU:
                switch (current_menu) {
                    case MENU_BLUETOOTH:
                        // 这里是从菜单页进入蓝牙页面
                        ESP_LOGI(TAG, "进入蓝牙播放模式");
                        update_system_state(STATE_BLUETOOTH_PLAY);
                        break;
                    case MENU_SD_CARD:
                        // 这里是从菜单页进入SD卡页面
                        ESP_LOGI(TAG, "进入内存卡播放模式"); // 在更新系统状态前先提示
                        update_system_state(STATE_SD_PLAY);
                        break;
                    case MENU_SETTINGS:
                        // 这里是从菜单页进入设置页面
                        ESP_LOGI(TAG, "进入设置界面");
                        update_system_state(STATE_SETTINGS);
                        break;
                    default:
                        break;
                }
                break;
                
            case STATE_BLUETOOTH_PLAY: {
                    // 检查蓝牙连接状态
                    if (!a2dp_sink.is_connected()) {
                        ESP_LOGW(TAG, "蓝牙未连接，无法操作播放状态");
                        break;
                    }

                    // 根据当前播放状态切换按键行为并及时更新播放状态
                    if (current_audio_state == ESP_A2D_AUDIO_STATE_STARTED) {
                        a2dp_sink.pause(); // 暂停播放
                        current_audio_state = ESP_A2D_AUDIO_STATE_REMOTE_SUSPEND; // 更新蓝牙播放状态为暂停
                        ESP_LOGI(TAG, "暂停蓝牙播放");
                    } else {
                        // 尝试恢复播放：先确保 I2S 处于活跃状态
                        if (!i2s_out.isActive()) {
                            ESP_LOGI(TAG, "I2S 未激活，重新初始化...");
                            i2s_init(I2S_PORT_NUM, current_sample_rate, current_bit_depth, current_channels, current_dac_mode);
                        }
                        a2dp_sink.play(); // 恢复播放
                        current_audio_state = ESP_A2D_AUDIO_STATE_STARTED; // 更新蓝牙播放状态为播放
                        ESP_LOGI(TAG, "恢复蓝牙播放");
                    }

                    // 更新播放/暂停符号
                    if (current_state == STATE_BLUETOOTH_PLAY && current_audio_state == ESP_A2D_AUDIO_STATE_STARTED) {
                        OLED_ShowCJKString(0, 2, "⏸", 12, true); // 显示播放状态
                    } else if (current_state == STATE_BLUETOOTH_PLAY && 
                        (current_audio_state == ESP_A2D_AUDIO_STATE_REMOTE_SUSPEND || 
                        current_audio_state == ESP_A2D_AUDIO_STATE_STOPPED)){
                        OLED_ShowCJKString(0, 2, "▶", 12, true); // 显示暂停状态
                    }
                }
                break;
                
            case STATE_SD_PLAY:
                if (sd_playing) {
                    ESP_LOGI(TAG, "手动暂停SD卡播放");
                    sd_pause_playback();  // 暂停播放
                    sd_playing = false; // 暂停播放后，再重置播放标志
                    sd_paused = true; // 暂停播放后，再设置暂停标志
                } else if (sd_paused) {
                    ESP_LOGI(TAG, "手动恢复SD卡播放");
                    sd_play_current_track();  // 恢复播放
                    sd_playing = true; // 恢复播放后，再设置播放标志
                    sd_paused = false; // 恢复播放后，再重置暂停标志
                }
                draw_sd_play_screen();
                break;
                
            case STATE_SETTINGS:
                update_system_state(STATE_MAIN_MENU);
                break;
                
            case STATE_SHUTDOWN_CONFIRM:
                update_system_state(STATE_POWER_OFF);
                break;
                
            default:
                break;
        }
    } else if (encoder_key_state == KEY_LONG_PRESS) {
        switch (current_state) {
            case STATE_MAIN_MENU:
                update_system_state(STATE_SHUTDOWN_CONFIRM);
                break;
                
            case STATE_BLUETOOTH_PLAY:
                a2dp_sink.pause(); // 先暂停蓝牙播放
                current_audio_state = ESP_A2D_AUDIO_STATE_REMOTE_SUSPEND; // 更新蓝牙播放状态为暂停
                vTaskDelay(pdMS_TO_TICKS(500));
                a2dp_sink.stop(); // 断开蓝牙                
                current_audio_state = ESP_A2D_AUDIO_STATE_STOPPED; // 更新蓝牙播放状态为停止
                update_system_state(STATE_MAIN_MENU);
                break;
                
            case STATE_SD_PLAY:
                ESP_LOGI(TAG, "手动停止SD卡播放");
                sd_manual_sw = true;     // 设置手动切换标志，避免手动切换的同时发生自动切换
                sd_stop_playback();
                update_system_state(STATE_MAIN_MENU);
                break;
                
            case STATE_SETTINGS:
                update_system_state(STATE_MAIN_MENU);
                break;
                
            case STATE_SHUTDOWN_CONFIRM:
                update_system_state(STATE_MAIN_MENU);
                break;
                
            case STATE_POWER_OFF:
                update_system_state(STATE_WELCOME);
                break;
                
            default:
                break;
        }
    }
}

// 菜单导航函数，添加screen_on检查
static void handle_menu_navigation() {
    // 只有亮屏状态才处理菜单导航
    if (!screen_on) return;
    
    // 可以在这里添加其他按键的处理逻辑
}

// 更新系统状态
static void update_system_state(SystemState new_state) {
    if (current_state == STATE_SD_PLAY && new_state != STATE_SD_PLAY) {
        sd_card_unmount();
    }

    if (new_state == STATE_POWER_OFF) {
        OLED_Clear();
        OLED_ShowCJKString(0, 3, "正在关机...", 12, true);
        vTaskDelay(pdMS_TO_TICKS(1000));
        OLED_Display_Off();
        screen_on = false;
        
        a2dp_sink.pause();
        sd_stop_playback();
    }
    
    current_state = new_state;
    last_user_activity = millis();

    if (new_state == STATE_BLUETOOTH_PLAY || new_state == STATE_SD_PLAY) {
        screen_on = true;
        OLED_Display_On();
    }
    
    switch (new_state) {
        case STATE_WELCOME:
            // 这里是进入欢迎界面要处理的任务
            OLED_Display_On();
            screen_on = true;
            draw_welcome_screen();
            break;
            
        case STATE_MAIN_MENU:
            // 这里是进入主菜单要处理的任务
            OLED_Clear(); // 先清屏
            draw_main_menu();
            break;
            
        case STATE_BLUETOOTH_PLAY:
            // 这里是进入蓝牙模式要处理的任务
            play_mode = A2DP_SINK; // 更新播放模式为A2DP_SINK
            if (!is_a2dp_started) {
                // 恢复并固定蓝牙模式的dac音量为默认值
                cs43131_vol = DEFAULT_DAC_VOLUME;
                cs43131_set_vol(CS43131L_ADDR, cs43131_vol);
                cs43131_set_vol(CS43131R_ADDR, cs43131_vol);
                a2dp_sink.set_auto_reconnect(true);
                a2dp_sink.set_task_core(1);
                a2dp_sink.set_event_queue_size(30);
                a2dp_sink.set_event_stack_size(4096);
                a2dp_sink.set_i2s_stack_size(4096);
                a2dp_sink.set_i2s_task_priority(configMAX_PRIORITIES - 4);

                a2dp_sink.set_i2s_ringbuffer_size(16384);
                a2dp_sink.set_i2s_write_size_upto(1440);
                a2dp_sink.set_i2s_ticks(50);

                a2dp_sink.start(bt_name);
                is_a2dp_started = true;
                vTaskDelay(pdMS_TO_TICKS(1000));
                if (a2dp_sink.is_avrc_connected()) {
                    a2dp_sink.set_volume(DEFAULT_AVRC_VOLUME);
                }

                if (!a2dp_sink.is_avrc_connected()) {
                    ESP_LOGW(TAG, "AVRC not ready...");
                    vTaskDelay(pdMS_TO_TICKS(1000));
                }
            }
            draw_bluetooth_play_screen();
            break;
            
        case STATE_SD_PLAY: {
            // 这里是进入SD卡模式要处理的任务
            play_mode = SD_MODE; // 更新播放模式为SD_MODE
            esp_err_t ret = sd_card_mount();
            if (ret != ESP_OK) {
                OLED_Clear();
                OLED_ShowCJKString(0, 2, "SD卡挂载失败", 12, true);
                OLED_ShowCJKString(0, 4, "长按返回菜单", 12, true);
            } else {
                if (!sd_music_files.empty()) {
                    sd_manual_sw = false; // 因为这里一定是手动从菜单页进入SD卡页面，重置手动切换标志
                    sd_play_current_track();
                }
                draw_sd_play_screen();
            }
            break;
        }
            
        case STATE_SETTINGS:
            // 这里是进入设置界面要处理的任务
            if (is_a2dp_started) {
                a2dp_sink.pause();
                a2dp_sink.disconnect();
            }
            break;
            
        case STATE_SHUTDOWN_CONFIRM:
            // 这里是进入关机确认界面要处理的任务
            draw_shutdown_screen();
            break;
            
        default:
            break;
    }
}

// 绘制欢迎界面
static void draw_welcome_screen() {
    OLED_Clear();
    OLED_ShowCJKString(0, 2, "欢迎使用微冷播放器！", 12, true);
    OLED_ShowCJKString(12, 4, "短按进入主页", 12, true);
    vTaskDelay(pdMS_TO_TICKS(100)); // 等待100ms显示提示
}

// 绘制主菜单
static void draw_main_menu() {
    OLED_Clear();
    OLED_ShowCJKString(48, 0, "主菜单", 12, true);
    
    const char* menu_items[MENU_COUNT] = {
        "蓝牙播放",
        "内存卡播放",
        "设置"
    };
    
    for (int i = 0; i < MENU_COUNT; i++) {
        int y_pos = 2 + i * 2;
        if (i == current_menu) {
            OLED_ShowString(0, y_pos, ">", 12, true);
            OLED_ShowCJKString(12, y_pos, menu_items[i], 12, true);
        } else {
            OLED_ShowString(0, y_pos, " ", 12, true);
            OLED_ShowCJKString(12, y_pos, menu_items[i], 12, true);
        }
    }
}

// 绘制蓝牙播放界面
static void draw_bluetooth_play_screen() {
    OLED_Clear();
    
    // 这里只显示一次，后续在AVRC回调中更新
    // 这里显示歌曲标题（占用第2-3页）
    if (strlen(current_metadata.track_title) > 0) {
        OLED_ClearPage(2, 4); // 要多清除一页
        OLED_ShowCJKString(12, 2, current_metadata.track_title, 12, true);
    } else {
        OLED_ShowCJKString(12, 2, "未知曲目", 12, true);
    }

    if (current_state == STATE_BLUETOOTH_PLAY && current_audio_state == ESP_A2D_AUDIO_STATE_STARTED) {
        OLED_ShowCJKString(0, 2, "⏸", 12, true);
    } else if (current_state == STATE_BLUETOOTH_PLAY && 
        (current_audio_state == ESP_A2D_AUDIO_STATE_REMOTE_SUSPEND || 
        current_audio_state == ESP_A2D_AUDIO_STATE_STOPPED)){
        OLED_ShowCJKString(0, 2, "▶", 12, true);
    }
    
    // 这里显示蓝牙歌词（第4页及以后）
    if (strlen(current_metadata.title) > 0) {
        OLED_ShowCJKString(0, 4, current_metadata.title, 12, true);
    } else {
        OLED_ShowCJKString(0, 4, "等待播放...", 12, true);
    }
    
    // // 显示状态栏（占用0-1页）
    oled_show_info(current_dac_mode, current_sample_rate, current_bit_depth, current_codec_name, get_local_vol());
}

// 绘制内存卡播放界面
static void draw_sd_play_screen() {
    OLED_Clear();
    
    if (sd_card == NULL) {
        OLED_ShowCJKString(0, 2, "SD卡未挂载", 12, true);
        OLED_ShowCJKString(0, 4, "请检查SD卡", 12, true);
    } else if (sd_music_files.empty()) {
        OLED_ShowCJKString(0, 2, "未找到音乐文件", 12, true);
        OLED_ShowCJKString(0, 4, "请添加音频文件", 12, true);
    } else {
        std::string filename = sd_music_files[current_sd_track];
        size_t last_slash = filename.find_last_of("/");
        if (last_slash != std::string::npos) {
            filename = filename.substr(last_slash + 1);
        }

        OLED_ClearPage(2, 4); // 要多清除一页
        
        // 显示文件名称（占用2-3页，从第12字符开始）
        OLED_ShowCJKString(12, 2, filename.c_str(), 12, true);

        // 显示SD卡播放/暂停状态（占用第2-3页前12字符）
        if (sd_playing) {
            OLED_ShowCJKString(0, 2, "⏸", 12, true);
        } else if (sd_paused) {
            OLED_ShowCJKString(0, 2, "▶", 12, true);
        } else {
            OLED_ShowCJKString(0, 2, "▶", 12, true);
        }

        OLED_ClearPage(4, 8); // 要多清除一页
        
        char track_info[64];
        sprintf(track_info, "%d/%d", current_sd_track + 1, sd_music_files.size());
        OLED_ShowString(0, 4, track_info, 12, true); // 显示曲目文件情况

        char total_time_str[32];
        sprintf(total_time_str, "%d:%02d", sd_total_duration / 60, sd_total_duration % 60);
        OLED_ShowString(30, 4, total_time_str, 12, true); // 仅显示总时间

        // // 如果正在播放或暂停，显示进度(这里不会更新)
        // if ((sd_playing || sd_paused) && sd_total_duration > 0) {
        //     uint32_t current_seconds = (sd_current_position * 8) / audio_file_bit_rate; // 使用从歌曲获得的实际的比特率
        //     char time_str[32];
        //     sprintf(time_str, "%d:%02d/%d:%02d",
        //             current_seconds / 60, current_seconds % 60,
        //             sd_total_duration / 60, sd_total_duration % 60);
        //     OLED_ShowString(54, 4, time_str, 12, true);
        // }
    }

    // 显示状态栏（占用0-1页）
    oled_show_info(current_dac_mode, current_sample_rate, current_bit_depth, current_codec_name, get_local_vol());
}

// 绘制设置界面
static void draw_settings_screen() {
    OLED_Clear();
    OLED_ShowCJKString(0, 48, "设置", 12, true);
    
    OLED_ShowCJKString(0, 2, "息屏时间: ", 12, true);
    OLED_ShowNum(60, 2, screen_timeout, 12, true);
    OLED_ShowCJKString(84, 2, "秒", 12, true);
    
    OLED_ShowCJKString(0, 4, "短按确认，长按返回", 12, true);
}

// 绘制关机界面
static void draw_shutdown_screen() {
    OLED_Clear();
    OLED_ShowCJKString(24, 2, "确认关机?", 12, true);
    OLED_ShowCJKString(0, 4, "短按确认，长按取消", 12, true);
}

// 检查屏幕超时
static void check_screen_timeout() {
    if (current_state == STATE_BLUETOOTH_PLAY || current_state == STATE_SD_PLAY) {
        if (!screen_on) {
            screen_on = true;
            OLED_Display_On();
        }
        last_user_activity = millis();
        return;
    }

    if (current_state != STATE_POWER_OFF && screen_on && 
        millis() - last_user_activity > screen_timeout * 1000) {
        OLED_Display_Off();
        screen_on = false;
    }
}

// 内存卡初始化
static void sd_card_init() {
    ESP_LOGI(TAG, "初始化SD卡功能");
    
    gpio_reset_pin(SD_DET);
    gpio_set_direction(SD_DET, GPIO_MODE_INPUT);
    gpio_set_pull_mode(SD_DET, GPIO_PULLUP_ONLY);
    
    sd_card = NULL;
}

// 挂载SD卡
static esp_err_t sd_card_mount() {
    if (sd_card != NULL) {
        ESP_LOGI(TAG, "SD卡已挂载");
        return ESP_OK;
    }

    if (gpio_get_level(SD_DET) != 0) {
        ESP_LOGE(TAG, "未检测到SD卡");
        return ESP_FAIL;
    }

    ESP_LOGI(TAG, "开始挂载SD卡 (4bit模式)");
    
    sdmmc_host_t host = SDMMC_HOST_DEFAULT();
    host.max_freq_khz = SDMMC_FREQ_HIGHSPEED;
    
    sdmmc_slot_config_t slot_config = SDMMC_SLOT_CONFIG_DEFAULT();
    slot_config.width = 4;
    
    esp_vfs_fat_sdmmc_mount_config_t mount_config = {
        .format_if_mount_failed = false,
        .max_files = 5,
        .allocation_unit_size = 16 * 1024
    };
    
    esp_err_t ret = esp_vfs_fat_sdmmc_mount("/sdcard", &host, &slot_config, &mount_config, &sd_card);
    
    if (ret != ESP_OK) {
        if (ret == ESP_FAIL) {
            ESP_LOGE(TAG, "挂载文件系统失败，如需格式化请设置format_if_mount_failed = true");
        } else {
            ESP_LOGE(TAG, "初始化SD卡失败 (%s)，请检查硬件连接", esp_err_to_name(ret));
        }
        return ret;
    }
    
    sdmmc_card_print_info(stdout, sd_card);
    ESP_LOGI(TAG, "SD卡挂载成功");
    
    sd_card_scan();
    
    return ESP_OK;
}

// 卸载SD卡
static esp_err_t sd_card_unmount() {
    if (sd_card == NULL) {
        ESP_LOGI(TAG, "SD卡未挂载");
        return ESP_OK;
    }
    
    ESP_LOGI(TAG, "开始卸载SD卡");
    
    if (sd_playing || sd_paused) {
        sd_stop_playback();
        sd_playing = false;
        sd_paused = false;
    }
    
    esp_err_t ret = esp_vfs_fat_sdcard_unmount("/sdcard", sd_card);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "卸载SD卡失败: %s", esp_err_to_name(ret));
        return ret;
    }
    
    sd_card = NULL;
    sd_music_files.clear();
    current_sd_track = 0;
    
    ESP_LOGI(TAG, "SD卡卸载成功");
    return ESP_OK;
}

// 扫描内存卡中的音乐文件 - 在menuconfig的FAT配置要开启Long filename support和配置为utf-8
static void sd_card_scan() {
    ESP_LOGI(TAG, "开始扫描SD卡中的音乐文件");
    sd_music_files.clear();
    
    if (sd_card == NULL) {
        ESP_LOGE(TAG, "SD卡未挂载，无法扫描文件");
        return;
    }
    
    // 使用 opendir 打开目录
    DIR* dir = opendir("/sdcard");
    if (!dir) {
        ESP_LOGE(TAG, "无法打开SD卡根目录");
        return;
    }
    
    struct dirent *entry;
    while ((entry = readdir(dir)) != NULL) {  // 直接使用 readdir 读取目录项
        std::string filename = entry->d_name;
        // 跳过目录和系统文件
        if (entry->d_type != DT_REG) continue;
        
        size_t dot_pos = filename.find_last_of(".");
        if (dot_pos != std::string::npos) {
            std::string ext = filename.substr(dot_pos + 1);
            std::transform(ext.begin(), ext.end(), ext.begin(), ::tolower);
            
            // 检查支持的音频文件格式
            if (ext == "MP3" || ext == "mp3" || 
                ext == "WAV" || ext == "wav" || 
                ext == "FLAC" || ext == "flac" || ext == "fla" || 
                ext == "AAC" || ext == "aac" || 
                ext == "M4A" || ext == "m4a" || 
                ext == "OPUS" || ext == "opus") {
                std::string full_path = "/sdcard/" + filename;
                sd_music_files.push_back(full_path); // 使用 std::string 存储完整路径（sd_music_files），显示时通过 substr 提取文件名
                ESP_LOGI(TAG, "发现音乐文件: %s", filename.c_str());
            }
        }
    }
    closedir(dir);  // 使用 closedir 关闭目录
    
    ESP_LOGI(TAG, "扫描完成，共发现 %d 个音乐文件", sd_music_files.size());
}

// 播放当前内存卡曲目函数
static void sd_play_current_track() {
    if (sd_card == NULL || sd_music_files.empty()) {
        ESP_LOGE(TAG, "SD卡未挂载或无音乐文件");
        return;
    }

    // 从暂停状态恢复：不仅要重置标志，还要重启解码器
    if (sd_paused) {
        ESP_LOGI(TAG, "从暂停恢复播放");
        sd_playing = true;
        sd_paused = false;
        
        // 重新启动解码器以确保状态正确
        if (!decoder.isNotifyActive()) {
            decoder.begin();
        } else {
            decoder.end(); // 重置解码器状态
            vTaskDelay(pdMS_TO_TICKS(10)); 
            decoder.begin(); // 重启解码器
        }
        
        // 刷新I2S输出流
        if (!i2s_out.isActive()) {
            i2s_init(I2S_PORT_NUM, current_sample_rate, current_bit_depth, current_channels, current_dac_mode);
        }
        
        return;
    }

    // 停止当前播放（若存在）
    if (sd_playing && audio_play_task_handle != NULL) {
        sd_stop_playback();
        vTaskDelay(pdMS_TO_TICKS(100));
    }

    std::string filename = sd_music_files[current_sd_track];
    ESP_LOGI(TAG, "播放SD曲目: %s", filename.c_str());

    // 检查文件类型
    uint8_t file_type = f_typetell(filename.c_str());
    if (file_type != FILE_MP3 && file_type != FILE_AAC && 
        file_type != FILE_WAV && file_type != FILE_FLAC) {
        ESP_LOGW(TAG, "不支持的文件类型，跳过: %s", filename.c_str());
        sd_next_track();
        return;
    }

    ESP_LOGI(TAG, "准备重置并初始化解码器");

    // 重置并初始化解码器
    decoder.end(); // 确保解码器已终止
    multi.end(); // 结束当前解码器

    // 在decoder启动前注册解码器到MultiDecoder（register supported codecs with their mime type）
    // 详见MimeDetector.h
    multi.addDecoder(mp3, "audio/mpeg");    // 注册MP3解码器，关联audio/mpeg
    multi.addDecoder(aac, "audio/aac");     // 注册AAC解码器，关联audio/aac
    multi.addDecoder(wav, "audio/vnd.wave");     // 注册WAV解码器，关联audio/wav
    multi.addDecoder(flac, "audio/flac");    // 注册FLAC解码器，关联audio/flac

    decoder.setOutput(&i2s_out); // 设置解码器输出为I2SStream的i2s_out对象
    decoder.removeNotifyAudioChange(info_callback); // 清除之前的回调
    decoder.addNotifyAudioChange(info_callback); // 添加新的解码器信息更新回调
    // decoder.setOutput(&i2s_out); // 设置解码器输出为I2SStream的i2s_out对象

    // 重置音频信息回调状态 - 测试内容
    info_callback.reset();  // 需要在AudioInfoCallback中添加reset方法

    // 在启动解码器前先确保 I2S 处于活跃状态（可有效解决重新进入SD卡模式出现的I2SStream::write()失败的错误）
    if (!i2s_out.isActive()) {
        ESP_LOGI(TAG, "I2S 未激活，重新初始化...");
        i2s_init(I2S_PORT_NUM, current_sample_rate, current_bit_depth, current_channels, current_dac_mode);
    }

    // 在I2S重启后启动解码器
    if (!decoder.begin()) {
        ESP_LOGE(TAG, "解码器初始化失败");
        return;
    }

    // 在解码器和I2S就绪后初始化信号量
    if (semaphore_handle == NULL) {
        semaphore_handle = xSemaphoreCreateBinary();
        xSemaphoreGive(semaphore_handle);
    }

    cs43131_vol = 60;
    cs43131_set_vol(CS43131L_ADDR, cs43131_vol);
    cs43131_set_vol(CS43131R_ADDR, cs43131_vol);

    // 更新播放标志和播放进度 - 文件从头播放
    sd_playing = true;
    sd_paused = false;
    sd_manual_sw = false; // 重置手动切换标志
    sd_current_file_pos = 0;

    if (audio_play_task_handle != NULL) {
        ESP_LOGW(TAG, "这是无效句柄，强制重置");
        // 因为来到这里只有可能是初次进入SD卡播放/之前执行过sd_stop_playback()函数；
        // 而sd_stop_playback()只能触发audio_play_task主动结束，不能保证其句柄被重置；
        // 所以这个句柄一定是无效的
        audio_play_task_handle = NULL; // 强制重置句柄
    }

    // 创建任务（若任务不存在）
    if (audio_play_task_handle == NULL) {
        ESP_LOGI(TAG, "audio_play_task_handle为NULL，创建audio_play_task任务");

        // 确保解码器已正确初始化 - 测试内容
        if (!decoder.isNotifyActive()) {
            if (!decoder.begin()) {
                ESP_LOGE(TAG, "解码器初始化失败");
                return;
            }
        }

        BaseType_t result = xTaskCreatePinnedToCore(
            audio_play_task, 
            "sd_audio_play", 
            8192, 
            (void*)filename.c_str(), 
            5, 
            &audio_play_task_handle, 
            1
        );
        if (result != pdPASS) {
        ESP_LOGE(TAG, "任务创建失败: %d", result);
        audio_play_task_handle = NULL;
        sd_playing = false;
        return;
    }
    } else {
        ESP_LOGI(TAG, "audio_play_task_handle不为NULL，跳过创建audio_play_task任务");
    }

    // 验证任务是否创建成功
    if (audio_play_task_handle == NULL) {
        ESP_LOGE(TAG, "播放任务创建失败！");
        sd_playing = false;
         // 尝试切换到下一首
        vTaskDelay(pdMS_TO_TICKS(100));
        sd_next_track();
        return;
    }

    draw_sd_play_screen();
}

// 停止内存卡播放函数
static void sd_stop_playback() {
    if (!sd_playing && !sd_paused) return;

    ESP_LOGI(TAG, "停止SD播放");
    sd_playing = false;   // 通知任务退出
    sd_paused = false;    // 确保任务不处于暂停状态

    // 等待任务自然退出（最多等待1秒）
    if (audio_play_task_handle != NULL) { 
        // 等待任务结束
        uint32_t timeout = 0;
        while (audio_play_task_handle != NULL && timeout < 100) {
            vTaskDelay(pdMS_TO_TICKS(10));
            timeout++;
        }
    }

    // 强制关闭文件
    if (g_current_file != NULL) {
        fclose(g_current_file);
        g_current_file = NULL;
    }

    // 清理解码器和输出流
    decoder.end();
    if (i2s_out.isActive()) {
        i2s_out.end();
        // 额外的硬件重置
        gpio_set_level(I2S_BCK, 0);
        gpio_set_level(I2S_WS, 0);
        gpio_set_level(I2S_DO, 0);
        vTaskDelay(pdMS_TO_TICKS(50));
    }

    // 重置信号量
    if (semaphore_handle != NULL) {
        vSemaphoreDelete(semaphore_handle);
        semaphore_handle = NULL;
    }

    // 重置音频参数
    audio_file_bit_rate = 0;
    sd_total_duration = 0;
    sd_current_position = 0;
    sd_current_file_pos = 0;

    vTaskDelay(pdMS_TO_TICKS(100));
}

// 暂停内存卡播放
static void sd_pause_playback() {
    if (!sd_playing || sd_paused) return;
    
    ESP_LOGI(TAG, "暂停SD播放");
    sd_playing = false;
    sd_paused = true;

    // 不删除播放任务，任务会进入等待状态并持续喂狗；同时保持I2S打开以便快速恢复
    draw_sd_play_screen();
}

// 下一首
static void sd_next_track() {
    if (sd_music_files.empty()) return;

    // 彻底停止当前播放并释放资源
    sd_stop_playback();
    vTaskDelay(pdMS_TO_TICKS(100)); // 等待资源释放

    // 切换到下一曲（循环播放）
    current_sd_track = (current_sd_track + 1) % sd_music_files.size();

    ESP_LOGI(TAG, "切换到下一曲: %s", sd_music_files[current_sd_track].c_str());

    // 重置音频参数
    audio_file_bit_rate = 0;
    sd_total_duration = 0;
    sd_current_position = 0;
    sd_current_file_pos = 0;
    
    // 播放新曲目
    sd_play_current_track();
    draw_sd_play_screen();
}

// 上一首
static void sd_prev_track() {
    if (sd_music_files.empty()) return;

    // 停止当前播放任务
    sd_stop_playback();
    vTaskDelay(pdMS_TO_TICKS(100)); // 等待资源释放
    
    // 切换到上一曲（循环播放）
    current_sd_track = (current_sd_track - 1 + sd_music_files.size()) % sd_music_files.size();

    ESP_LOGI(TAG, "切换到上一曲: %s", sd_music_files[current_sd_track].c_str());

    // 重置音频参数
    audio_file_bit_rate = 0;
    sd_total_duration = 0;
    sd_current_position = 0;
    sd_current_file_pos = 0;

    // 播放新曲目
    sd_play_current_track();
    draw_sd_play_screen();
}

// 音量变化回调函数，添加screen_on检查
void volume_change_callback(int vol) {
    unsigned long current_time = millis();
    
    // 息屏状态下只亮屏不调整音量
    if (!screen_on) {
        screen_on = true;
        OLED_Display_On();
        last_user_activity = current_time;
        return;
    }
    
    uint8_t new_vol = (vol < AVRC_VOLUME_MIN) ? AVRC_VOLUME_MIN :
                      (vol > AVRC_VOLUME_MAX) ? AVRC_VOLUME_MAX : vol;
    
    int diff = abs(vol - last_processed_volume);
    bool is_threshold_exceeded = (diff >= VOLUME_THRESHOLD) || (last_processed_volume == -1);
    bool is_time_elapsed = (current_time - last_volume_time) >= DEBOUNCE_DELAY;
    
    if (is_threshold_exceeded || is_time_elapsed) {
        encoder_software_lock = true;

        avrc_vol = new_vol;
        ESP_LOGI(TAG, "A2DP Source vol: %d → 本地avrc_vol同步为%d", vol, avrc_vol);
        
        if (current_state == STATE_BLUETOOTH_PLAY && screen_on) {
            oled_show_info(current_dac_mode, current_sample_rate, current_bit_depth, current_codec_name, get_local_vol());
        }

        encoder_software_lock = false;
        
        last_processed_volume = vol;
        last_volume_time = current_time;
        last_user_activity = current_time;
    }
}

// 内存卡播放进度更新任务
static void sd_playback_monitor_task(void *arg) {
    sd_playback_monitor_task_handle = xTaskGetCurrentTaskHandle();
    esp_task_wdt_add(sd_playback_monitor_task_handle);
    while (1) {
        if (current_state == STATE_SD_PLAY) {
            static unsigned long last_log = 0;
            if (millis() - last_log > 5000) {
                // ESP_LOGI(TAG, "内存卡播放监控任务运行中");
                last_log = millis();
            }
            
            // 检查播放任务是否正常运行
            if (sd_playing && audio_play_task_handle) {
                // 向任务发送喂狗通知
                xTaskNotifyGive(audio_play_task_handle);
            }
        }
        vTaskDelay(pdMS_TO_TICKS(100));
        esp_task_wdt_reset(); // 监控任务自身也要喂狗
    }
}

extern "C" void app_main(void) {
    esp_log_level_set("BT_API", ESP_LOG_WARN);
    esp_log_level_set("BT_AV", ESP_LOG_WARN);
    esp_log_level_set("gpio", ESP_LOG_WARN);
    esp_log_level_set("audio-tools", ESP_LOG_WARN); // 屏蔽StreamCopy时的大量常规copy日志
    esp_log_level_set("libhelix", ESP_LOG_WARN); // 屏蔽mp3解码时的大量常规日志

    esp_task_wdt_deinit();

    esp_task_wdt_config_t twdt_config = {
        .timeout_ms = 15000,
        .idle_core_mask = (1 << 0) | (1 << 1),
        .trigger_panic = true,
    };
    esp_task_wdt_init(&twdt_config);

    esp_err_t ret_buf[10] = {0};

    current_dac_mode = MODE_SLAVE;

    ret_buf[0] = nvs_flash_init();
    if (ret_buf[0] == ESP_ERR_NVS_NO_FREE_PAGES || ret_buf[0] == ESP_ERR_NVS_NEW_VERSION_FOUND) {
        ESP_ERROR_CHECK(nvs_flash_erase());
        ret_buf[1] = nvs_flash_init();
        ESP_LOGI("NVS", "Flash-NVS分区已重新初始化");
    }

    ret_buf[2] = spi_init();
    ret_buf[3] = i2c_init(I2C_NUM, I2C_FREQ, I2C_SDA, I2C_SCL);
    ret_buf[4] = i2c_scan(I2C_NUM);
    ret_buf[5] = i2s_init(I2S_PORT_NUM, current_sample_rate, current_bit_depth, current_channels, current_dac_mode);
    ret_buf[6] = cs43131_dual_init(current_sample_rate, current_bit_depth, current_dac_mode);
    ret_buf[7] = cs43131_set_vol(CS43131L_ADDR, cs43131_vol);
    ret_buf[8] = cs43131_set_vol(CS43131R_ADDR, cs43131_vol);
    ret_buf[9] = OLED_Init();

    buttons_init();
    sd_card_init();

    xTaskCreatePinnedToCore(input_handler_task, "input_task", 4096, NULL, 5, NULL, 0);
    xTaskCreatePinnedToCore(sd_playback_monitor_task, "sd_monitor_task", 4096, NULL, 4, NULL, 0);

    for (int i = 0; i < 10; i++) {
        if (ret_buf[i] != ESP_OK) {
            ESP_LOGI(TAG, "Operation ret[%d] failed: %s", i, esp_err_to_name(ret_buf[i]));
            return;
        }
    }

    ESP_LOGI(TAG, "ESP32初始化完成，欢迎使用！");

    a2dp_sink.set_on_connection_state_changed(connection_state_changed);
    
    a2dp_sink.set_avrc_metadata_attribute_mask(
        ESP_AVRC_MD_ATTR_TITLE |
        ESP_AVRC_MD_ATTR_ARTIST |
        ESP_AVRC_MD_ATTR_ALBUM |
        ESP_AVRC_MD_ATTR_GENRE |
        ESP_AVRC_MD_ATTR_TRACK_NUM
    );
    a2dp_sink.set_avrc_metadata_callback(avrc_metadata_callback);
    a2dp_sink.set_on_audio_state_changed(audio_state_changed);
    a2dp_sink.set_codec_config_callback(codec_config_callback);

    a2dp_sink.set_avrc_rn_events({ESP_AVRC_RN_VOLUME_CHANGE});

    a2dp_sink.set_avrc_connection_state_callback([](bool connected) {
        if (connected) {
            ESP_LOGI(TAG, "AVRC连接成功，支持双向音量控制");
        } else {
            ESP_LOGW(TAG, "AVRC连接断开，音量同步失效");
        }
    });

    a2dp_sink.set_avrc_rn_volumechange(volume_change_callback);

    a2dp_sink.set_avrc_rn_volumechange_completed([](int vol) {
        ESP_LOGI(TAG, "Source vol: %d", vol);
    });

    current_state = STATE_POWER_OFF;
    OLED_Display_On();
    OLED_Clear();
    // 这里预留写开机流程的地方
    screen_on = true;
    current_state = STATE_WELCOME;
    draw_welcome_screen();
    
    ESP_LOGI(TAG, "等待短按编码器进入菜单...");
    while (true) {
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}

